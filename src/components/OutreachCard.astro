
---
const {
  title,
  description,
  image,
  reel,
  url,
  imagePosition = "left",
} = Astro.props;

// Convert an Instagram Reel URL to its embeddable URL.
const reelId = reel?.match(/\/(?:reel|p)\/([^/?#]+)/)?.[1];

const reelEmbed = reelId
  ? `https://www.instagram.com/p/${reelId}/embed/`
  : undefined;
---

<div
  class:list={[
    "outreach-card",
    imagePosition === "right" && "image-right",
  ]}
>
<div class="outreach-media">
  {
    reelEmbed ? (
      <div class="outreach-reel">
        <blockquote
          class="instagram-media"
          data-instgrm-permalink={reelEmbed.replace(/embed\/$/, "")}
          data-instgrm-version="14"
        >
          <a
            href={reelEmbed.replace(/embed\/$/, "")}
            target="_blank"
            rel="noopener noreferrer"
          >
            Watch on Instagram
          </a>
        </blockquote>
      </div>
    ) : image ? (
      <img
        src={image}
        alt={title}
        class="outreach-image"
        loading="lazy"
      />
    ) : null
  }
</div>

  <div class="outreach-content">
    {
      url ? (
        <a
          href={url}
          target="_blank"
          rel="noopener noreferrer"
          class="outreach-title"
        >
          {title}
        </a>
      ) : (
        <div class="outreach-title">{title}</div>
      )
    }

    <p class="outreach-description">
      {description}
    </p>
  </div>
</div>

<style>
  .outreach-card {
    display: grid;
    grid-template-columns: 320px minmax(0, 1fr);
    overflow: hidden;
    background: var(--background);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.12);
  }

  .outreach-card.image-right {
    grid-template-columns: minmax(0, 1fr) 320px;
  }

  .outreach-card.image-right .outreach-media {
    order: 2;
  }

  .outreach-media {
    position: relative;
    min-width: 0;
    min-height: 400px;
    overflow: hidden;
  }

  .outreach-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .outreach-reel {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 500px;
    border: 0;
    background: white;
  }

  .outreach-content {
    padding: 1.5rem 2rem;
  }

  .outreach-title {
    display: block;
    font-family: "Caudex", "Alice", Georgia, serif;
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.25;
    color: var(--subheading);
    margin-bottom: 1rem;
  }

  a.outreach-title {
    text-decoration: underline;
  }

  a.outreach-title:hover {
    opacity: 0.7;
  }

  .outreach-description {
    line-height: 1.6;
  }

  @media (max-width: 640px) {
    .outreach-card,
    .outreach-card.image-right {
      grid-template-columns: 1fr;
    }

    .outreach-card.image-right .outreach-media {
      order: 0;
    }

    .outreach-media {
      min-height: 0;
    }

    .outreach-image {
      position: static;
      height: 260px;
    }

    .outreach-reel {
        width: 100%;
        height: 100%;
        min-height: 550px;
        display: flex;
        justify-content: center;
        align-items: flex-start;
        overflow: hidden;
    }

    .outreach-reel :global(.instagram-media) {
        width: 100% !important;
        max-width: 540px !important;
        margin: 0 auto !important;
    }

    .outreach-content {
      padding: 1.25rem;
    }
  }
</style>

<script>
  function initializeInstagram() {
    const instagram = window as Window & {
      instgrm?: {
        Embeds: {
          process: () => void;
        };
      };
    };

    if (instagram.instgrm) {
      instagram.instgrm.Embeds.process();
      return;
    }

    if (document.querySelector('script[src*="instagram.com/embed.js"]')) {
      return;
    }

    const script = document.createElement("script");
    script.src = "https://www.instagram.com/embed.js";
    script.async = true;
    script.onload = () => instagram.instgrm?.Embeds.process();
    document.body.appendChild(script);
  }

  document.addEventListener("astro:page-load", initializeInstagram);
</script>