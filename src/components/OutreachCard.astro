---
const {
  title,
  description,
  image,
  url,
  imagePosition = "left",
} = Astro.props;
---

<div class:list={[
  "outreach-card",
  imagePosition === "right" && "image-right"
]}>
  <img
    src={image}
    alt={title}
    class="outreach-image"
  />

  <div class="outreach-content">
    {
      url ? (
        <a href={url} target="_blank" class="outreach-title">
          {title}
        </a>
      ) : (
        <div class="outreach-title">{title}</div>
      )
    }

    <p class="outreach-description">
      {description}
    </p>
  </div>
</div>

<style>
  .outreach-card {
    display: grid;
    grid-template-columns: 320px 1fr;
    overflow: hidden;
    background: var(--background);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.12);
  }

  .outreach-card.image-right {
    grid-template-columns: 1fr 320px;
  }

  .outreach-card.image-right .outreach-image {
    order: 2;
  }

  .outreach-image {
    width: 100%;
    height: 100%;
    min-height: 250px;
    object-fit: cover;
  }

  .outreach-content {
    padding: 1.5rem 2rem;
  }

  .outreach-title {
    display: block;
    font-family: "Caudex", "Alice", Georgia, serif;
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.25;
    color: var(--subheading);
    margin-bottom: 1rem;
  }

  a.outreach-title {
    text-decoration: underline;
  }

  a.outreach-title:hover {
    opacity: 0.7;
  }

  .outreach-description {
    line-height: 1.6;
  }

  @media (max-width: 640px) {
    .outreach-card,
    .outreach-card.image-right {
      grid-template-columns: 1fr;
    }

    .outreach-card.image-right .outreach-image {
      order: 0;
    }

    .outreach-image {
      height: 240px;
    }

    .outreach-content {
      padding: 1.25rem;
    }
  }
</style>