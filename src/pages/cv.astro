  <div class="mb-5">
    <div class="section-title text-3xl w-full font-bold mb-5 mt-10">Experience</div>
  </div>

  <div class="time-line-container mb-10">
    <TimeLineElement
      title="Postdoctoral Researcher"
      subtitle="April 2025 - Present, ASTRON, Netherlands"
    >
      Searching for radio transients in LOFAR data as part of the AstroFlash team.
    </TimeLineElement>
    <TimeLineElement
      title="Rubicon Research Fellow"
      subtitle="Jan 2023 - March 2025, Jodrell Bank Centre for Astrophysics, University of Manchester, UK"
    >
      Searching for FRBs with the MeerKAT radio telescope as part of the MeerTRAP project.
    </TimeLineElement>
    <TimeLineElement
      title="PhD thesis in Astrophysics"
      subtitle="Sept 2018 - Nov 2022, Anton Pannekoek Institute, University of Amsterdam, Netherlands"
    >
      Exploring the link between Neutron Stars and Fast Radio Bursts
    </TimeLineElement>
  </div>

  <div class="mb-5">
    <div class="section-title text-3xl w-full font-bold mb-5 mt-10">Education</div>
  </div>

  <div class="time-line-container grid gap-4 mb-10">
    <TimeLineElement
      title="MSc in astrophysics"
      subtitle="2016 - 2018, Université Paul Sbatier, Toulouse, France.
      MSc thesis at IRAP."
    />
    <TimeLineElement
      title="BSc in Physics"
      subtitle="2013 - 2016, Université Paul Sabatier, Toulouse, France.
      Graduated with honours."
    />
    <TimeLineElement
      title="Bachibac - Bachillerato & Baccalauréat"
      subtitle="Double Spanish and French high school diploma. 
      Ranked first in my graduation cohort. 
      2011 - 2013, Segovia, Spain. "
    />    
  </div>

